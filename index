function tree(t){box(t.x,0,t.z,.35,3.4,.35,'#795c42');box(t.x,3,t.z,2.4,1.1,2.4,'#4c8355',.4);box(t.x,3.7,t.z,1.65,1.0,1.65,'#67955d',.9)}function marker(x,z,c){let y=.5+Math.sin(clock*2)*.15;box(x,y,z,.47,.47,.47,c,clock);let v=camera([x,3.1,z]);if(v[2]>.25&&v[2]<110)labels.push({p:project(v),text:'▼',size:clamp(focus*.35/v[2],10,27),color:c,depth:v[2],outline:true})}
function render(){faces=[];floor=[];labels=[];let g=ctx.createLinearGradient(0,0,0,H*.66);g.addColorStop(0,'#6babc7');g.addColorStop(.67,'#b8d5df');g.addColorStop(1,'#f0d8a9');ctx.fillStyle=g;ctx.fillRect(0,0,W,H);let hz=H*.50-focus*Math.tan(.23);ctx.fillStyle='#859d8b';ctx.beginPath();ctx.moveTo(0,hz);for(let i=0;i<=10;i++)ctx.lineTo(W*i/10,hz-8-22*Math.sin(i*1.9+cam.a));ctx.lineTo(W,H);ctx.lineTo(0,H);ctx.fill();ground();for(let b of buildings)if(dist(b,cam)<175){box(b.x,0,b.z,b.w,b.h,b.d,b.c,0,true);box(b.x,b.h,b.z,b.w*.88,.45,b.d*.88,'#6c7b80');if(b.h>25)box(b.x,b.h+.45,b.z,3,1.8,3,'#98a4a6')}for(let t of trees)if(dist(t,cam)<120)tree(t);for(let t of lights)if(dist(t,cam)<95){box(t.x,0,t.z,.16,4.5,.16,'#6e7777');box(t.x,4.4,t.z,.9,.15,.22,'#d8e0c8');}for(let z of [14,46]){for(let x of [26,34])box(x,0,z,.14,2,.14,'#efeee4');box(30,1.94,z,8.15,.14,.14,'#efeee4')}for(let c of cars)car(c);for(let n of npcs)person(n,n);if(!activeCar)person(player,kits[kit],true);if(mission===1)for(let c of coins)if(!c.got)marker(c.x,c.z,'#f4df48');if(mission===2)marker(-60,60,'#8af0a3');drawList(floor,false);drawList(faces);labels.sort((a,b)=>b.depth-a.depth);for(let l of labels){ctx.font=`900 ${l.size}px Arial`;ctx.textAlign='center';ctx.textBaseline='middle';if(l.outline){ctx.strokeStyle='#14212c';ctx.lineWidth=3;ctx.strokeText(l.text,...l.p)}ctx.fillStyle=l.color;ctx.fillText(l.text,...l.p)}}
function blocked(x,z,r=.6){if(Math.abs(x)>144||Math.abs(z)>144)return true;return buildings.some(b=>Math.abs(x-b.x)<b.w/2+r&&Math.abs(z-b.z)<b.d/2+r)}function move(p,dx,dz,r){if(!blocked(p.x+dx,p.z,r))p.x+=dx;if(!blocked(p.x,p.z+dz,r))p.z+=dz}function notify(t){$('toast').textContent=t;$('toast').style.opacity=1;toastUntil=clock+3}function setMission(){let titles=['ЗНАКОМСТВО','ЗОЛОТЫЕ МЯЧИ','СУПЕРКАР','СВОБОДНЫЙ ГОРОД'],texts=['Найди Месси (голубая метка на карте) и нажми E.','Собери 9 золотых мячей на поле.','Сядь в спорткар (F) и доедь до зелёной метки.','Все задания пройдены! Исследуй город и встречай звёзд.'];$('missionTitle').textContent=titles[mission];$('missionText').textContent=texts[mission];}function earn(n){money+=n;$('money').textContent='$'+money.toLocaleString('en-US')}function nearest(arr,max){let p=activeCar||player;return arr.filter(o=>dist(p,o)<max).sort((a,b)=>dist(p,a)-dist(p,b))[0]}
function act(k){if(k==='escape'){if(wardrobe){closeWardrobe();return}togglePause();return}if(!started||paused||wardrobe)return;if(k==='r'){startSiu();return}if(siu&&['space','f','e'].includes(k))return;if(k==='c'){openWardrobe();return}if(k==='space'){if(!activeCar&&player.y<.03){player.vy=6.4;player.y=.04;}return}if(k==='f'){if(activeCar){let c=activeCar;player.x=c.x+Math.cos(c.a)*2.6;player.z=c.z-Math.sin(c.a)*2.6;if(blocked(player.x,player.z)){player.x=c.x;player.z=c.z-3;}player.a=c.a;angle=c.a;activeCar=null;carSpeed=0;carLook=0;notify('Ты вышел из машины');}else{let c=nearest(cars,4.3);if(c){activeCar=c;carSpeed=0;carLook=0;angle=c.a;notify(c.name+' · за рулём')}else notify('Подойди к спорткару ближе');}return}if(k==='e'&&!activeCar){let n=nearest(npcs,4.2);if(n){if(!found.has(n.name)){found.add(n.name);earn(100);notify(n.name+': Привет, Криштиану! +$100');}else notify(n.name+': SIUUU!');if(mission===0&&n.name==='MESSI'){mission=1;setMission();earn(250);notify('Месси: Собери мячи на поле! +$250');}}else notify('Подойди к футболисту ближе')}}
function update(dt){clock+=dt;if(clock>toastUntil)$('toast').style.opacity=0;if(!started||paused||wardrobe)return;for(let n of npcs){let oldx=n.x,oldz=n.z,phase=clock*.55+n.baseX;n.x=n.baseX+Math.sin(phase)*2.0;n.z=n.baseZ+Math.cos(phase)*3.0;n.a=Math.atan2(n.x-oldx,n.z-oldz);n.walk+=dt*6;}let turn=(keys.arrowright?1:0)-(keys.arrowleft?1:0);if(activeCar){let c=activeCar;let gas=(keys.w||keys.arrowup?1:0)-(keys.s||keys.arrowdown?1:0);carSpeed+=gas*dt*14;carSpeed*=Math.exp(-dt*(keys[' ']?4.8:gas?.55:1.4));carSpeed=clamp(carSpeed,-8,28);let steer=(keys.d?1:0)-(keys.a?1:0);c.a+=steer*dt*1.75*clamp(carSpeed/5,-1,1);let dx=Math.sin(c.a)*carSpeed*dt,dz=Math.cos(c.a)*carSpeed*dt;let oldx=c.x,oldz=c.z;move(c,dx,dz,1.5);if(Math.hypot(c.x-oldx,c.z-oldz)<Math.hypot(dx,dz)*.3)carSpeed*=-.25;angle=c.a+carLook;player.x=c.x;player.z=c.z;if(mission===2&&Math.hypot(c.x+60,c.z-60)<6){mission=3;earn(1000);setMission();notify('Задание выполнено! +$1000')}}else{angle+=turn*dt*1.7;if(siu){updateSiu(dt)}else{let f=(keys.w||keys.arrowup?1:0)-(keys.s||keys.arrowdown?1:0),r=(keys.d?1:0)-(keys.a?1:0),l=Math.hypot(f,r);if(l){let s=(keys.shift?10:5.4)*dt;let dx=(Math.sin(angle)*f+Math.cos(angle)*r)/l*s,dz=(Math.cos(angle)*f-Math.sin(angle)*r)/l*s;move(player,dx,dz,.4);player.a=Math.atan2(dx,dz);player.walk+=dt*(keys.shift?15:10)}else player.walk*=.82;player.vy-=dt*15;player.y=Math.max(0,player.y+player.vy*dt);if(player.y===0)player.vy=0;}if(mission===1){for(let c of coins)if(!c.got&&dist(c,player)<2){c.got=true;earn(50);notify('Золотой мяч '+coins.filter(c=>c.got).length+'/9');}if(coins.every(c=>c.got)){mission=2;setMission();earn(500);notify('Все мячи собраны! +$500')}}}let t=activeCar||player,back=activeCar?12:7.2;let x=t.x-Math.sin(angle)*back,z=t.z-Math.cos(angle)*back;cam.x=x;cam.z=z;cam.y=(activeCar?5.7:4.3)+(player.y||0)*.6;cam.a=angle;let h=activeCar?'F — выйти из машины':nearest(cars,4.3)?'F — сесть в '+nearest(cars,4.3).name:nearest(npcs,4.2)?'E — поговорить с '+nearest(npcs,4.2).name: