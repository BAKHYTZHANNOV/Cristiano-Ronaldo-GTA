function minimap(){let c=mctx,s=180/300,tx=x=>90+x*s,tz=z=>90-z*s;c.fillStyle='#647e63';c.fillRect(0,0,180,180);c.fillStyle='#38444b';for(let r of roads){c.fillRect(tx(r)-4,0,8,180);c.fillRect(0,tz(r)-4,180,8)}c.fillStyle='#b0b5a9';for(let b of buildings)c.fillRect(tx(b.x-b.w/2),tz(b.z+b.d/2),b.w*s,b.d*s);c.fillStyle='#48a65b';c.fillRect(tx(12),tz(48),36*s,36*s);function dot(x,z,col,r){c.fillStyle=col;c.beginPath();c.arc(tx(x),tz(z),r,0,TAU);c.fill()}for(let n of npcs)dot(n.x,n.z,n.name==='MESSI'?'#65dafa':'#f8e3e7',3);for(let car of cars)dot(car.x,car.z,'#ffd74d',2.5);if(mission===1)for(let o of coins)if(!o.got)dot(o.x,o.z,'#ffef66',2.5);if(mission===2)dot(-60,60,'#91ff8c',5);c.save();c.translate(tx(player.x),tz(player.z));c.rotate(angle);c.fillStyle='#fff';c.strokeStyle='#17242c';c.lineWidth=1.4;c.beginPath();c.moveTo(0,-6);c.lineTo(-5,5);c.lineTo(0,3);c.lineTo(5,5);c.closePath();c.stroke();c.fill();c.restore();}
function openWardrobe(){wardrobe=true;keys={};releaseMouse();$('wardrobe').style.display='flex';document.querySelectorAll('.kitcard').forEach((e,i)=>e.classList.toggle('active',i===kit));}function closeWardrobe(){wardrobe=false;$('wardrobe').style.display='none';cv.focus({preventScroll:true});}kits.forEach((k,i)=>{let e=document.createElement('button');e.className='kitcard';let bg=k.style==='stripes'?'repeating-linear-gradient(90deg,#fff 0 9px,#20232b 9px 18px)':k.style==='hoops'?'repeating-linear-gradient(0deg,#fff 0 9px,#258648 9px 18px)':k.top;e.innerHTML=`<div class="shirt" style="background:${bg};color:${k.top==='#f1f0e8'?'#343344':'white'}">${k.num}</div><b>${k.name}</b><small>${k.year}</small>`;e.onclick=()=>{kit=i;$('kitName').textContent=k.label;document.querySelectorAll('.kitcard').forEach((e,j)=>e.classList.toggle('active',i===j));notify('Форма: '+k.name)};$('kits').appendChild(e)});$('closeKit').onclick=closeWardrobe;$('kitBtn').onclick=openWardrobe;$('siuBtn').onclick=()=>{startSiu();cv.focus({preventScroll:true});captureMouse();};function togglePause(){if(!started)return;paused=!paused;keys={};if(paused)releaseMouse();$('menu').style.display=paused?'flex':'none';$('play').innerHTML=paused?'ПРОДОЛЖИТЬ <span>▶</span>':'ИГРАТЬ <span>▶</span>';$('touch').classList.toggle('show',!paused);if(!paused)cv.focus({preventScroll:true});}$('pauseBtn').onclick=togglePause;$('play').onclick=()=>{started=true;paused=false;keys={};$('menu').style.display='none';$('hud').style.display='block';$('touch').classList.add('show');cv.focus({preventScroll:true});captureMouse();};
// Physical key codes work with English, Russian and other layouts.
const keyCodes={KeyW:'w',KeyA:'a',KeyS:'s',KeyD:'d',KeyF:'f',KeyE:'e',KeyC:'c',KeyR:'r',Space:' ',ShiftLeft:'shift',ShiftRight:'shift',ArrowUp:'arrowup',ArrowDown:'arrowdown',ArrowLeft:'arrowleft',ArrowRight:'arrowright',Escape:'escape'};
const keyFallback={'ц':'w','ф':'a','ы':'s','в':'d','а':'f','у':'e','с':'c','к':'r'};
function keyName(e){return keyCodes[e.code]||keyFallback[(e.key||'').toLowerCase()]||(e.key||'').toLowerCase()}
const gameKeys=new Set(Object.values(keyCodes));
window.addEventListener('keydown',e=>{let k=keyName(e);if(!gameKeys.has(k))return;if(!started)return;e.preventDefault();if(!keys[k]&&!e.repeat)act(k===' '?'space':k);keys[k]=true},true);
