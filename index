window.addEventListener('blur',()=>keys={});document.addEventListener('visibilitychange',()=>{if(document.hidden)keys={}});
function releaseMouse(){if(document.pointerLockElement===cv&&document.exitPointerLock)document.exitPointerLock()}
function captureMouse(){if(!started||paused||wardrobe||!cv.requestPointerLock||document.pointerLockElement===cv||matchMedia('(pointer:coarse)').matches)return;try{let r=cv.requestPointerLock();if(r&&r.catch)r.catch(()=>{});}catch(e){/* browser preview may prohibit locking; free mouse still works */}}
function look(dx,dy){if(!started||paused||wardrobe)return;dx=clamp(dx,-150,150);dy=clamp(dy,-100,100);if(activeCar){carLook=clamp(carLook+dx*.0035,-1.8,1.8);}else{angle+=dx*.0035;if(!siu&&!keys.w&&!keys.a&&!keys.s&&!keys.d)player.a=angle;}cam.p=clamp(cam.p+dy*.0025,-.08,.7);}
// Pointer lock for unlimited mouse movement, free mouse fallback for previews.
document.addEventListener('mousemove',e=>{if(document.pointerLockElement===cv){look(e.movementX||0,e.movementY||0)}});
let touchDrag=null,mousePrev=null;
cv.addEventListener('pointerdown',e=>{if(!started||paused||wardrobe)return;cv.focus({preventScroll:true});if(e.pointerType==='touch'){touchDrag={x:e.clientX,y:e.clientY};try{cv.setPointerCapture(e.pointerId)}catch(err){}}else{mousePrev={x:e.clientX,y:e.clientY};captureMouse()}});
